{
  "name": "sol-lending-protocol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:programs": "anchor build",
    "test:programs": "anchor test",
    "test:rust": "cargo test",
    "db:up": "docker compose up -d postgres redis prometheus",
    "db:migrate": "pnpm --filter @sol-lend/indexer prisma migrate dev --name init",
    "dev:indexer": "pnpm --filter @sol-lend/indexer dev",
    "dev:bot": "pnpm --filter @sol-lend/bot dev",
    "dev:frontend": "pnpm --filter @sol-lend/frontend dev",
    "lint": "cargo clippy --all-targets -- -D warnings"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.95.3",
    "@types/bn.js": "^5.1.5",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "chai": "^4.4.1",
    "mocha": "^10.7.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/wallet-adapter-wallets": "^0.19.40",
    "bn.js": "^5.2.5",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  }
}